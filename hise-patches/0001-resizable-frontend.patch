         {
@@ -288,6 +306,22 @@ void FrontendProcessorEditor::resized()
 #else
 	int width = originalSizeX;
 	int height = originalSizeY;
+
+	// JXMP patch: the editor was resized from outside (host, window manager), scale the interface
+	// to the new size and remember it as the global scale factor
+	if (!scaleUpdateInProgress && originalSizeX > 0 && originalSizeY > 0 && getWidth() > 0 && getHeight() > 0)
+	{
+		auto s = jmin((float)getWidth() / (float)originalSizeX, (float)getHeight() / (float)originalSizeY);
+
+		if (std::abs(s - scaleFactor) > 0.001f && s > 0.2f)
+		{
+			scaleFactor = s;
+			container->setTransform(AffineTransform::scale(scaleFactor));
+
+			if (auto gm = dynamic_cast<GlobalSettingManager*>(getAudioProcessor()))
+				gm->setGlobalScaleFactor(scaleFactor, dontSendNotification);
+		}
+	}
 #endif
 
     container->setBounds(0, 0, width, height);
