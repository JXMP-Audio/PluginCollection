diff --git a/hi_frontend/frontend/FrontEndProcessor.cpp b/hi_frontend/frontend/FrontEndProcessor.cpp
index a7b72bb..8d8c890 100644
--- a/hi_frontend/frontend/FrontEndProcessor.cpp
+++ b/hi_frontend/frontend/FrontEndProcessor.cpp
@@ -731,8 +731,22 @@ FrontendStandaloneApplication::MainWindow::MainWindow(String name) : DocumentWin
 	setContentOwned(new AudioWrapper(), true);
 
 	centreWithSize(getWidth(), getHeight());
-		
-	setResizable(false, false);
+
+	// JXMP patch: free resizing with the aspect ratio of the interface
+	setResizable(true, false);
+
+	if (auto c = getConstrainer())
+	{
+		const int w = getContentComponent()->getWidth();
+		const int h = getContentComponent()->getHeight();
+
+		if (w > 0 && h > 0)
+		{
+			c->setFixedAspectRatio((double)w / (double)h);
+			c->setSizeLimits(w / 3, h / 3, w * 3, h * 3);
+		}
+	}
+
 	setVisible(true);
 }
 
