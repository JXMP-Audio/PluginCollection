+	setResizable(true, true);
+	updateResizeLimits();
+}
+
+void FrontendProcessorEditor::updateResizeLimits()
+{
+	if (originalSizeX <= 0 || originalSizeY <= 0)
+		return;
+
+	if (auto c = getConstrainer())
+	{
+		c->setFixedAspectRatio((double)originalSizeX / (double)originalSizeY);
+		c->setSizeLimits(originalSizeX / 2, originalSizeY / 2, originalSizeX * 3, originalSizeY * 3);
+	}
 }
 
